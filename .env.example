# Required
OPENAI_API_KEY=
TAVILY_API_KEY=

# Optional / backup
SERPAPI_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Model config (optional overrides)
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=

# LangSmith observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_xxxxxxxxxxxx
LANGCHAIN_PROJECT=finnie-ai-finance-assistant

# Logging format
# - "human" (default): pipe-delimited terminal-friendly
# - "json":            one JSON object per log line; for production aggregators
LOG_FORMAT=human