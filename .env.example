# =============================================================
# REQUIRED — Finnie won't start without these
# =============================================================

# OpenAI — powers all LLM calls (agents, orchestrator, synthesizer,
# eval judge) + embeddings + Moderation API for input guardrails.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Tavily — powers the News agent (domain-allowlisted financial news search).
# Get one at https://app.tavily.com/
TAVILY_API_KEY=tvly-...

# LangSmith — observability + the 5 eval suites depend on this.
# Get one at https://smith.langchain.com/settings (free tier covers dev usage)
LANGCHAIN_API_KEY=lsv2_pt_xxxxxxxxxxxx
LANGCHAIN_TRACING_V2=true

# =============================================================
# OPTIONAL — overrides for defaults defined in config.yaml
# =============================================================

# LangSmith project name (defaults to "finnie-ai-finance-assistant")
LANGCHAIN_PROJECT=finnie-ai-finance-assistant

# Override the model picks if you want — defaults come from config.yaml.
# Production agents use gpt-4o-mini; eval judge uses gpt-4o.
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=

# Logging format:
#   "human" (default) — pipe-delimited, terminal-friendly
#   "json"            — one JSON object per line; for production aggregators
LOG_FORMAT=human

# =============================================================
# FUTURE USE — declared but not currently wired into any agent
# =============================================================
# SerpAPI was prototyped as a backup news source; superseded by Tavily.
# Alpha Vantage was prototyped as a backup market data source; superseded by yfinance.
# Kept as placeholders in case either gets integrated later. Safe to leave blank.
SERPAPI_API_KEY=
ALPHA_VANTAGE_API_KEY=
